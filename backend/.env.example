# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=catalogo_user
DB_PASSWORD=catalogo_pass
DB_NAME=multicatalogo

# --- Redis ---
# Opción A (la usada por defecto): host y puerto
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Opción B: una URI completa (si se define, tiene prioridad). Ej: redis://localhost:6379/0
# REDIS_URL=

# --- Demostración de ACID en clase (dejar apagado en uso normal) ---
# true  -> falla a propósito DESPUÉS de insertar el pedido y ANTES de insertar los items (ROLLBACK).
SIMULAR_FALLA_CHECKOUT=false
# Segundos de pausa justo antes del COMMIT (para hacer "docker kill catalogo_postgres" a mitad de la compra).
CHECKOUT_PAUSA_SEGUNDOS=0

# --- Despliegue en la nube (Render) ---
# URL completa de PostgreSQL. Si existe, tiene prioridad sobre DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME.
# DATABASE_URL=postgres://usuario:clave@host:5432/multicatalogo
# "disable" en local (Docker); "require" si la base exige TLS (solo aplica cuando NO se usa DATABASE_URL).
DB_SSLMODE=disable
# Orígenes extra permitidos por CORS (separados por coma): la URL del frontend desplegado.
# CORS_ORIGINS=https://catalogo-upse-web.onrender.com
